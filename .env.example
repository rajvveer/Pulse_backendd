# ──────────────────────────────────────────────────────────────────────────
# Pulse Backend — environment template. Copy to .env and fill in.
# Only NON-secret defaults are shown; never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ===== Core =====
NODE_ENV=development
PORT=3000
API_VERSION=v1
SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===== Required secrets (app refuses to boot in production without these) =====
JWT_SECRET=
JWT_REFRESH_SECRET=
TEMP_JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/pulse
MONGO_TEST_URI=mongodb://localhost:27017/pulse_test
# Per-CONTAINER Mongo connection budget. Per-process pool = budget / workers.
# Keep (budget × maxReplicas) under your Atlas tier's connection cap.
MONGO_CONTAINER_POOL_BUDGET=50
MONGO_OPTIONS_MIN_POOL_SIZE=2
# MONGO_OPTIONS_MAX_POOL_SIZE=   # optional explicit override (skips derivation)
MONGO_OPTIONS_SERVER_SELECTION_TIMEOUT_MS=5000

# ===== Redis (required in production) =====
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_RETRIES=3

# ===== Process / runtime =====
# Number of cluster workers when running `node src/cluster.js` (defaults to CPU
# count). Leave unset for one-process-per-container (recommended on k8s).
CLUSTER_WORKERS=
# HTTP server timeouts (ms). keepAlive < headers; both should exceed LB idle.
HTTP_KEEPALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=30000
# Graceful shutdown drain budget (ms).
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_FORCE_MS=30000

# ===== Networking / proxy =====
# Hops between client and this process (LB + ingress + platform). Match your
# topology: too low collapses everyone to one rate-limit bucket; too high lets
# clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ===== Socket.IO =====
# Leave false (websocket-only). Set true ONLY with LB sticky sessions.
SOCKET_ENABLE_POLLING=false

# ===== Rate limiting =====
RATE_LIMIT_MAX_REQUESTS=1000   # per-user global ceiling / 15 min
AUTH_RATE_LIMIT_MAX=100        # per-IP, pre-auth
OTP_RATE_LIMIT_MAX=30          # per-IP (per-identifier limits enforced separately)
UPLOAD_RATE_LIMIT_MAX=60       # per-user

# ===== Feed / cache TTLs (seconds) =====
FEED_CANDIDATE_TTL_SEC=30
FEED_PAGE_TTL_SEC=20
FOLLOW_GRAPH_TTL_SEC=60
REEL_CANDIDATE_TTL_SEC=30
TRENDING_HASHTAG_TTL_SEC=600

# ===== Uploads (memory safety) =====
UPLOAD_MAX_MB=25               # per image/file
UPLOAD_MAX_FILES=5
UPLOAD_MAX_INFLIGHT_MB=256     # process-wide in-flight upload byte budget
REEL_MAX_MB=80                 # per reel video

# ===== Sanitization caps =====
SANITIZE_MAX_DEPTH=12
SANITIZE_MAX_NODES=5000
SANITIZE_MAX_STRING=50000
JSON_BODY_LIMIT=256kb

# ===== Background jobs =====
ENABLE_BACKGROUND_JOBS=false

# ===== Email OTP (Brevo) =====
EMAIL_API_KEY=

# ===== SMS OTP (Twilio) + spend cap =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_GLOBAL_DAILY_MAX=5000      # global circuit breaker on SMS sends/day

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pulse/media

# ===== Observability =====
SENTRY_DSN=
LOG_LEVEL=info
# Required to expose /metrics, /status, /health/detailed in production.
INTERNAL_STATUS_KEY=
# ENABLE_API_DOCS=true         # expose Swagger in production (off by default)
